    <maplayer type="raster" autoRefreshEnabled="0">
      <id>P01_ndvi_crop</id>
      <datasource>./GIS/rasters/P01_NDVI.tif</datasource>
      <layername>P01 NDVI</layername>
      <provider>gdal</provider>
      <pipe>
        <rasterrenderer type="singlebandgray" grayBand="1" opacity="1" alphaBand="-1">
          <contrastEnhancement>
            <minValue>-1</minValue>
            <maxValue>1</maxValue>
            <algorithm>1</algorithm>
          </contrastEnhancement>
        </rasterrenderer>
      </pipe>
    </maplayer>
    <maplayer type="raster" autoRefreshEnabled="0">
      <id>P01_zone_mask</id>
