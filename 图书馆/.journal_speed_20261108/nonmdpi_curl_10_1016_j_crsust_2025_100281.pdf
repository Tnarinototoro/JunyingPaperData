<div class="search-bar-wrapper" itemscope itemtype="http://schema.org/WebSite">
    <meta itemprop="url" content="https://research.slu.se/"/>

    <div class="global-search-wrapper">
        <form id="main-search" action="/en/searchAll/" method="get" class="search-form" itemprop="potentialAction" itemscope itemtype="http://schema.org/SearchAction">
            <meta itemprop="target" content="/en/searchAll/"/>

            
            <div class="global-search  no-concept-search">
                <div class="field-button-wrapper">

                    








<script>
    $(document).ready(function () {
        runToolTips();
        runRadioGroup();

        function changeSearchPlaceholder(radio) {
            $('#global-search-input').attr('placeholder', radio.attr('data-placeholder'));
        }

        $('[role="radio"]').on('click', function () {
            changeSearchPlaceholder($(this));
        });

        $('[role="radio"]').on('keydown', function () {
            changeSearchPlaceholder($(this));
        });

        $('.search-form').on('submit', function (e) {
            e.preventDefault();

            var searchValue = $('.search-bar-wrapper input.search-field').val() || '';
            if (!searchValue.trim()) {
                this.submit();
                return;
            }

            var selectedRadio = $('.advanced-search-list [role="radio"][aria-checked="true"]');
            var searchBy = selectedRadio && selectedRadio.attr('id');
            var baseUrl;

            // This is for the community layout where a dropdown is available to pick content types from
            var dropdownLink = $('.form-field-dropdown ul.dropdown-menu li a[aria-selected="true"]');

            if (dropdownLink.length > 0) {
                var href = dropdownLink.attr('href');
                baseUrl = href.split('?')[0];
            } else {
                var locale = $('.advanced-search-list').attr('data-searchlocale') || 'en';
                var dataPage = $('body').attr('data-page');
                var family = (dataPage === 'home' || !dataPage) ? 'searchAll' : dataPage;
                var urlString = window.location.origin + window.location.pathname;
                var localeIndex = urlString.indexOf('/' + locale);

                if (localeIndex === -1) {
                    // Locale not found in URL, append it
                    baseUrl = urlString + (urlString.endsWith('/') ? '' : '/') + locale + '/' + family;
                } else {
                    // Locale found in URL, use existing logic
                    baseUrl = urlString.substring(0, localeIndex + locale.length + 2) + family;
                }

            }
            var urlParams = {};
            

            if (false) {
                urlParams["improvedLayoutOrganisationUuid"] = "";
            }

            urlParams["search"] = searchValue;
            if (searchBy) {
                urlParams["searchBy"] = searchBy;
            }

            var paramsAsString = jQuery.param(urlParams);
            window.location.href = baseUrl + '/?' + paramsAsString;
        });
    });
</script>

                    <div class="search-field-container">
