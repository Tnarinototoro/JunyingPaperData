    <div class="global-search-wrapper">
        <div class="global-search mini">
            <div class="field-button-wrapper">
                <div class="search-cell search-field">
                    <label for="main-search" class="sr-only">Search content at University of Edinburgh Research Explorer</label>
                    <input id="main-search" class="search-field" value="" name="search"
                           placeholder="Search..."/>
                </div>

                <div class="search-submit">
                    <button type="submit" aria-label="Search">
                        <i class="icon icon-magnifying-glass" aria-hidden="true"></i>
                    </button>
